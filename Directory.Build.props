<Project>
  <!-- Standalone build settings for the public Affiant framework repo.
       Formerly imported from the monorepo root props via GetPathOfFileAbove; inlined here
       so the extracted repo is self-contained (no parent props exists above this root). -->
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>alpha.1</VersionSuffix>
    <Authors>Seevali</Authors>
    <PackageProjectUrl>https://github.com/Sakwala/affiant</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Sakwala/affiant</RepositoryUrl>
  </PropertyGroup>

  <!-- Canonical values snapshotted here — the single source of truth this file already is for
       Version/RepositoryUrl — for Directory.Build.targets' packaging NFR gate to validate every
       project against. Evaluated at Directory.Build.props import time, i.e. before any
       per-project csproj override could apply, so these stay the "expected" value even if a
       csproj later drifts. Never duplicate these as literals anywhere else (that duplication is
       exactly the bug this fixes: see affiant-chancery docs/architecture-review/area-8-public-api-packaging.md,
       ruling 4). Changing the org or flipping VersionSuffix requires editing only this file. -->
  <PropertyGroup>
    <AffiantCanonicalVersion Condition="'$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</AffiantCanonicalVersion>
    <AffiantCanonicalVersion Condition="'$(VersionSuffix)' == ''">$(VersionPrefix)</AffiantCanonicalVersion>
    <AffiantCanonicalRepositoryUrl>$(RepositoryUrl)</AffiantCanonicalRepositoryUrl>
  </PropertyGroup>

  <!-- GHSA-2m69-gcr7-jv3q: SQLitePCLRaw.lib.e_sqlite3 <= 2.1.11 bundles a vulnerable SQLite;
       no patched version exists as of 2026-07-04 (advisory first_patched_version = null).
       Suppresses the NU1903 audit warning (which would fail the build under TreatWarningsAsErrors
       on a cold restore) for this one advisory only. NuGetAudit stays on for everything else.
       REMOVE when upstream ships a patched SQLitePCLRaw and the EF Core Sqlite chain is bumped. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>
</Project>
