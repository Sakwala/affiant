  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:Affiant.Extensions.AI.Adapters.ExtensionsAIInferenceCompletionPort.#ctor(Microsoft.Extensions.AI.IChatClient,Microsoft.Extensions.Logging.ILogger{Affiant.Extensions.AI.Adapters.ExtensionsAIInferenceCompletionPort})</Target>
    <Left>lib/net10.0/Affiant.Extensions.AI.dll</Left>
    <Right>lib/net10.0/Affiant.Extensions.AI.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
</Suppressions>