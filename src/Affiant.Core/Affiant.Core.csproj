<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Affiant.Core</PackageId>
    <Description>Affiant Framework — Concrete services for context extraction, review gating, and telemetry. Includes ContextFabric, ReviewGate, DeterministicShortCircuit, base ContextExtractor, TaskInferenceStep, and AffiantTelemetry.</Description>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Framework layering: Core depends on Abstractions only -->
  <ItemGroup>
    <ProjectReference Include="..\Affiant.Abstractions\Affiant.Abstractions.csproj" />
  </ItemGroup>

  <!-- Zero references to adapter packages or host apps -->

</Project>
