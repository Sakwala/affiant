<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Affiant.Core</PackageId>
    <Description>Affiant Framework — Concrete services for context extraction, review gating, and telemetry. Includes ContextFabric, ReviewGate, DeterministicShortCircuit, base ContextExtractor, TaskInferenceStep, and AffiantTelemetry.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- DocketDepthInstrument exposes the ObservableGauge instance it published so a test's
       MeterListener can enable measurements for THAT gauge rather than for every instrument sharing
       the name affiant.docket.pending. Public API would be the wrong home for a test seam. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Affiant.Core.Tests" />
  </ItemGroup>

  <!-- Framework layering: Core depends on Abstractions only -->
  <ItemGroup>
    <ProjectReference Include="..\Affiant.Abstractions\Affiant.Abstractions.csproj" />
  </ItemGroup>

  <!-- No Microsoft.SemanticKernel / Microsoft.Agents.AI / Microsoft.Extensions.AI reference:
       the interception pipeline here is backend-neutral (L2 AC #4). Formerly these
       Microsoft.Extensions.* abstractions arrived transitively through Semantic Kernel. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <!-- IHostedService, for AffiantWireUpValidator (area-8 ruling 6) — the startup check that fails a
         host whose ReviewGate dependencies were never registered. Abstractions-only and part of the
         ASP.NET Core shared framework, so it costs a hosted adopter nothing on disk. Pinned to
         10.0.4 to match what Affiant.SemanticKernel and Affiant.Docket already reference — a higher
         floor here surfaces as an NU1605 downgrade error in every project referencing both. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
  </ItemGroup>

  <!-- Zero references to adapter packages or host apps -->

</Project>
