<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Affiant.Docket</RootNamespace>
    <AssemblyName>Affiant.Docket</AssemblyName>
    <PackageId>Affiant.Docket</PackageId>
    <Description>Durable review queue for Affiant, providing persistence and expiry semantics for review workflows across multiple database backends.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Affiant.Abstractions/Affiant.Abstractions.csproj" />
    <ProjectReference Include="../Affiant.Core/Affiant.Core.csproj" />
    <!-- No ProjectReference to Affiant.EntityFramework (affiant#35, area-8 ruling 1): the two
         SQL-backed IDocketStore implementations that needed its AffiantDbContext moved into that
         package, restoring the DAG in CLAUDE.md's layering invariant. Do not re-add this edge —
         Affiant.Docket must stay installable without EF Core, Sqlite and Npgsql. -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <!-- BackgroundService / IHostedService — formerly transitive via Semantic Kernel through Core. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.4" />
  </ItemGroup>

</Project>
