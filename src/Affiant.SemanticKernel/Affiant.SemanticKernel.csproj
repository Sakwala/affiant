<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Affiant.SemanticKernel</PackageId>
    <Description>Semantic Kernel adapter for the Affiant framework — canonical filter pipeline wiring (task inference, context extraction, review gating, error handling), inference orchestration adapters, per-provider connector capabilities with manual tool-invocation fallback, and hard-failure startup validation</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Unit-test access to internal edge helpers (message conversions, the per-provider
       IConnectorCapabilities leaf classes CapabilityRegistry constructs). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Affiant.SemanticKernel.Tests" />
  </ItemGroup>

  <!-- Framework layering: SemanticKernel adapter depends on Core (which pulls in Abstractions) -->
  <ItemGroup>
    <ProjectReference Include="..\Affiant.Core\Affiant.Core.csproj" />
  </ItemGroup>

  <!-- Same SK version as Affiant.Core to avoid dependency resolution skew in hosts -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.4" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.74.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.OpenAI" Version="1.74.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Google" Version="1.74.0-alpha" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Ollama" Version="1.74.0-alpha" />
  </ItemGroup>

  <!-- Zero references to other adapter packages or host apps -->

</Project>
