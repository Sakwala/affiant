<?xml version="1.0" encoding="utf-8"?>
<!-- https://learn.microsoft.com/dotnet/fundamentals/package-validation/diagnostic-ids -->
<!--
  Declared breaks against 1.0.0-beta.1.1, permitted by the repository's prerelease-stability policy and
  required by it to be declared: the inference completion port and the manual tool invoker each take an
  injectable TimeProvider as an added optional constructor parameter, so every instant they stamp reads
  a clock a test can move. See CHANGELOG.md's upgrade notes.
-->
<Suppressions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:Affiant.SemanticKernel.Adapters.SemanticKernelInferenceCompletionPort.#ctor(System.IServiceProvider,Microsoft.Extensions.Logging.ILogger{Affiant.SemanticKernel.Adapters.SemanticKernelInferenceCompletionPort})</Target>
    <Left>lib/net10.0/Affiant.SemanticKernel.dll</Left>
    <Right>lib/net10.0/Affiant.SemanticKernel.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:Affiant.SemanticKernel.Connectors.ManualToolInvoker.#ctor(Affiant.Core.Services.ToolInvocationPipeline,Microsoft.Extensions.Logging.ILogger{Affiant.SemanticKernel.Connectors.ManualToolInvoker})</Target>
    <Left>lib/net10.0/Affiant.SemanticKernel.dll</Left>
    <Right>lib/net10.0/Affiant.SemanticKernel.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
</Suppressions>