<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Affiant.Testing.ComplianceHarness</PackageId>
    <Description>Test helper package for verifying compliance of Affiant.Core task inference strategies against their specifications. Validates strategy correctness via fixture-case assertions and strict-mode discoverability.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Affiant.Core\Affiant.Core.csproj" />
    <!-- The conformance runner files a proposal through the shipped gate against the shipped
         in-memory Docket and the shipped policy chain: what a compliance run measures has to be the
         packages a host installs, not a re-implementation living beside the test. -->
    <ProjectReference Include="..\Affiant.Docket\Affiant.Docket.csproj" />
    <ProjectReference Include="..\Affiant.Policies\Affiant.Policies.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
    <!-- Every fixture and every canonical vector is validated against the rulebook's own schema
         before it is run: a malformed document must be an error, never a pass. -->
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- The framework's own conformance test project is this package's first consumer, and it
         asserts on the runner's internals: the public surface is the entry point below, and the
         framework does not get a bigger one by being in the same repository. -->
    <InternalsVisibleTo Include="Affiant.Conformance.Tests" />
  </ItemGroup>

</Project>
