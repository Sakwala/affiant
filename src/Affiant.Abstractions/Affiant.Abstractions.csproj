<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Affiant.Abstractions</PackageId>
    <Description>Affiant Framework — Domain-agnostic primitives and interfaces. Primitives: ProvenanceTag, Affidavit, ToolEnvelope, DocketEntry. Interfaces: IChatSessionStore, IDocketStore, IApprovalPolicy, IFieldMapper, IWriteExecutor, IRouteRegistry, IStreamingTransport, IIntentInterceptor, IToolAuthorizationPolicy, ITaskInferenceStrategy.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- The telemetry-key registry (rulebook rule TL-1) ships inside the assembly so a host, a
       collector's config generator, or a conformance driver can read the exact key set a given
       Affiant.Abstractions build emits, without depending on a file next to the package. LogicalName
       is explicit so the resource name is a stated contract (TelemetryKeys.RegistryResourceName)
       rather than a side effect of RootNamespace and folder layout. -->
  <ItemGroup>
    <EmbeddedResource Include="Telemetry\telemetry-keys.json"
                      LogicalName="Affiant.Abstractions.Telemetry.telemetry-keys.json" />
  </ItemGroup>

  <!-- Two shapes in this package are the framework's to mint and nobody else's: the sealed
       decision hand-off (only the gate concludes a decision) and the attestor rehydration factories
       (only a store reads an attestation back off a row). Their constructors are internal, and this
       is the whole list of assemblies that may see them. A host cannot be on it. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Affiant.Core" />
    <InternalsVisibleTo Include="Affiant.Docket" />
    <InternalsVisibleTo Include="Affiant.EntityFramework" />
    <InternalsVisibleTo Include="Affiant.Abstractions.Tests" />
    <InternalsVisibleTo Include="Affiant.Core.Tests" />
    <InternalsVisibleTo Include="Affiant.Docket.Tests" />
    <InternalsVisibleTo Include="Affiant.EntityFramework.Tests" />
    <InternalsVisibleTo Include="Affiant.Transport.SignalR.Tests" />
    <InternalsVisibleTo Include="Affiant.Conformance.Tests" />
  </ItemGroup>

  <!-- Zero Affiant package references — enforced by static analysis test in Story 6.11.
       Zero Microsoft.SemanticKernel / Microsoft.Agents.AI / Microsoft.Extensions.AI references —
       the interception contracts here are backend-neutral. -->

</Project>
