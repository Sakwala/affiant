<Project>
  <!--
    Packaging NFR gate (NFR3, NFR4, NFR5).
    Runs before every `dotnet pack` on a packable framework project and asserts:
      - Version == the canonical version computed from Directory.Build.props'
        VersionPrefix/VersionSuffix   (NFR3: all packages share one version)
      - PackageId == MSBuildProjectName   (NFR4: PackageId matches directory/project name)
      - RepositoryUrl == Directory.Build.props' RepositoryUrl   (NFR5: correct repo metadata)

    The "expected" values are NOT literals here — they are $(AffiantCanonicalVersion) and
    $(AffiantCanonicalRepositoryUrl), snapshotted once in Directory.Build.props at import time
    (see the comment there). That means an org rename or a VersionSuffix flip is a
    Directory.Build.props-only edit; this file never needs a matching hand-edit again, and the
    gate still fails on genuine drift — e.g. a csproj that overrides RepositoryUrl/Version away
    from the shared value.

    Condition skips test projects and any non-packable scaffolding.
  -->
  <Target Name="ValidatePackagingNfrs"
          BeforeTargets="GenerateNuspec;Pack"
          Condition="'$(IsPackable)' == 'true'">

    <Message Text="ValidatePackagingNfrs: checking $(MSBuildProjectName) (Version=$(Version), PackageId=$(PackageId))"
             Importance="normal" />

    <Error
      Text="Version mismatch in $(MSBuildProjectFullPath): expected '$(AffiantCanonicalVersion)' (from Directory.Build.props VersionPrefix/VersionSuffix), got '$(Version)'. All framework packages must share the same version. Update Directory.Build.props to fix."
      Condition="'$(Version)' != '$(AffiantCanonicalVersion)'" />

    <Error
      Text="PackageId mismatch in $(MSBuildProjectFullPath): expected '$(MSBuildProjectName)' (directory name), got '$(PackageId)'. PackageId must match the project directory name exactly."
      Condition="'$(PackageId)' != '$(MSBuildProjectName)'" />

    <Error
      Text="RepositoryUrl mismatch in $(MSBuildProjectFullPath): expected '$(AffiantCanonicalRepositoryUrl)' (from Directory.Build.props), got '$(RepositoryUrl)'. Update the csproj or Directory.Build.props."
      Condition="'$(RepositoryUrl)' != '$(AffiantCanonicalRepositoryUrl)'" />

  </Target>
</Project>
