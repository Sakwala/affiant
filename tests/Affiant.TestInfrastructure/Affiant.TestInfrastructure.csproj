<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.5" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.74.0" />
    <PackageReference Include="OpenTelemetry" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseAffiantPackages)' != 'true'">
    <ProjectReference Include="..\..\src\Affiant.Abstractions\Affiant.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Affiant.Core\Affiant.Core.csproj" />
  </ItemGroup>

  <!-- Package mode exists for consumers that build this project against the PACKED framework
       (affiant-host-apps' PackageReference CI leg packs this tree into a local feed and then
       builds its hosts, which reference this project, with UseAffiantPackages=true). The version
       must therefore be the one this tree packs — Directory.Build.props' canonical value — and
       never a literal: the literal this used to carry (1.0.0-alpha.1) outlived its package on
       nuget.org, NuGet resolved the lowest version it could still find (1.0.0-beta.1) and NU1603
       failed the restore under TreatWarningsAsErrors; had it passed, this project would have
       compiled against beta.1 while the host built against the current release. -->
  <ItemGroup Condition="'$(UseAffiantPackages)' == 'true'">
    <PackageReference Include="Affiant.Abstractions" Version="$(AffiantCanonicalVersion)" />
    <PackageReference Include="Affiant.Core" Version="$(AffiantCanonicalVersion)" />
  </ItemGroup>

</Project>
