<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Affiant.Abstractions\Affiant.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Schema validation is a TEST-only dependency on purpose: the shipped packages must not make a
       consumer take a JSON Schema library to use them, and the schemas are the rulebook's artifact
       rather than this repository's. -->
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
  </ItemGroup>

  <!-- The vendored rulebook travels with the test binary: these tests read the v0.1 schemas and the
       protocol's wire fixtures at run time, and the run must not depend on the working directory or
       on a network fetch. The files are the ones conformance/sync.sh vendors from the ref
       conformance/PROTOCOL_PIN names, so the checksum verification CI runs (conformance/sync.sh
       with the verify flag) covers what this project reads; only the parts it reads are copied. -->
  <ItemGroup>
    <Content Include="../Affiant.Conformance.Tests/protocol/schemas/**/*"
             LinkBase="protocol/schemas" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Affiant.Conformance.Tests/protocol/fixtures/wire/**/*"
             LinkBase="protocol/fixtures/wire" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Affiant.Conformance.Tests/protocol/fixtures/enum-values.json"
             LinkBase="protocol/fixtures" CopyToOutputDirectory="PreserveNewest" />
    <!-- TelemetryKeyRegistryTests validates the shipped registry against telemetry-key.schema.json
         above, and checks its own validator against the rulebook's positive and negative fixtures
         for that schema. -->
    <Content Include="../Affiant.Conformance.Tests/protocol/fixtures/v0.1/telemetry-key/**/*"
             LinkBase="protocol/fixtures/v0.1/telemetry-key" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
