      "affidavit": {
        "operationType": "update",
        "entityId": "invoice-1",
        "aggregateConfidence": 0.9,
        "populatedConfidence": 0.9,
        "emptyFieldCount": 0,
        "fields": [
          {
            "name": "status",
            "value": "Active",
            "previousValue": "Draft",
            "source": "Conversation",
            "bound": false
          },
          {
            "name": "note",
            "value": "urgent",
