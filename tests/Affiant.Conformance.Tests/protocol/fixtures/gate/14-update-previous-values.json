      },
      "utterance": "Set the invoice status to Active",
      "messageId": "msg-1"
    },
    "prior": [],
    "step": {
      "kind": "file",
      "toolName": "relay_capture",
      "operation": {
        "kind": "update",
        "entityType": "Invoice",
        "entityId": "invoice-1",
        "fields": ["status", "note"]
