      "channel": "mcp",
      "principal": {
        "kind": "service",
        "id": "whatsapp-relay",
        "assertedMember": "ana",
        "relay": {
          "channelIdentity": "+94770000000",
          "messageId": "wamid-1"
        }
      },
      "utterance": "Active",
      "messageId": "wamid-1"
    },
    "prior": [
      {
        "kind": "file",
        "as": "filed",
        "at": "2026-09-04T09:00:00.000Z",
        "toolName": "relay_capture",
        "operation": {
