      "at": "2026-09-04T09:00:00.000Z",
      "tool": {
        "name": "update_invoice",
        "description": "Update an invoice",
        "entityType": "Invoice",
        "entityId": "invoice-1",
        "writeCapable": true,
        "fields": [
          {
            "name": "status",
            "kind": "enum",
            "description": "The invoice status",
