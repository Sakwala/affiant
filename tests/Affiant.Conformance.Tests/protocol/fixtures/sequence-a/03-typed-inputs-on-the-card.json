        {
          "name": "amount",
          "kind": "number",
          "value": 40,
          "allowedValues": null,
          "pattern": "^\\d+(\\.\\d{1,2})?$",
          "isMandatory": true
        },
        {
          "name": "dueOn",
          "kind": "date",
          "value": "2026-10-01",
